<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Concord.Host.Adapter</RootNamespace>
    <AssemblyName>Concord.Host.Adapter</AssemblyName>
    <ConcordDir Condition="'$(ConcordDir)' == ''">$(MSBuildThisFileDirectory)../../Assemblies/$(TargetFramework)</ConcordDir>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Concord.Host.Adapter</PackageId>
    <Description>Optional body-replacement backend for Concord, for hosts running the WaylithCLR fork of CoreCLR. A host side-loads it and keeps Concord's native detour backend when the fork is absent.</Description>
    <!-- Concord.dll is supplied by the host runtime, exactly as it is for Concord.Harmony, so it
         does not belong in this package's dependency group. Suppressing dependencies leaves a
         lib/ folder with no matching group, which the SDK flags as NU5128. -->
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <WarningsNotAsErrors>NU5128</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Reflection.Metadata"/>
    <Using Include="System.Reflection.Metadata.Ecma335"/>
    <Using Include="Concord.Emit"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Order-only: build the merged runtime first, but do not let MSBuild pick its reference,
         which resolves to the metadata-only Concord.Ref output instead of the ILRepack result. -->
    <ProjectReference Include="../Concord/Concord.csproj" ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Concord">
      <HintPath>../../Assemblies/$(TargetFramework)/Concord.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <UsingTask TaskName="ReadConcordBuildSha" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <AssemblyPath ParameterType="System.String" Required="true"/>
      <Sha ParameterType="System.String" Output="true"/>
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        string version = System.Diagnostics.FileVersionInfo.GetVersionInfo(AssemblyPath).ProductVersion ?? "";
        int plus = version.IndexOf('+');
        Sha = plus < 0 ? "" : version.Substring(plus + 1);
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="StampConcordBuild" BeforeTargets="GetAssemblyAttributes"
          Condition="Exists('$(ConcordDir)/Concord.dll')">
    <ReadConcordBuildSha AssemblyPath="$(ConcordDir)/Concord.dll">
      <Output TaskParameter="Sha" PropertyName="ConcordBuildSha"/>
    </ReadConcordBuildSha>
    <ItemGroup>
      <AssemblyMetadata Include="ConcordBuild" Value="$(ConcordBuildSha)" Condition="'$(ConcordBuildSha)' != ''"/>
    </ItemGroup>
  </Target>

</Project>
