<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <EmbedAllSources>true</EmbedAllSources>

    <!-- Only the packages under src opt back in per-project. -->
    <IsPackable>false</IsPackable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Package versions come from v-prefixed git tags (v1.2.3 -> 1.2.3). -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="all"/>
  </ItemGroup>

  <!-- Coverage for SonarCloud. Matched on the .Tests suffix so it lands on the real test
       projects and skips the fixture assemblies (ForeignTargets, RegistryAssembly,
       RollbackAssembly, Consumer), which are compiled targets rather than test hosts. -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="coverlet.collector" Version="10.0.1" PrivateAssets="all"/>
  </ItemGroup>

  <Import Project="StyleCop.props"/>
</Project>
